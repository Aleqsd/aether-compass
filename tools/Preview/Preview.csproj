<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <DalamudHome Condition="'$(DalamudHome)' == ''">$(APPDATA)/XIVLauncher/addon/Hooks/dev</DalamudHome>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AetherCompass.csproj" />
    <Reference Include="Dalamud" HintPath="$(DalamudHome)/Dalamud.dll" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudHome)/Dalamud.Bindings.ImGui.dll" />
    <Reference Include="FFXIVClientStructs" HintPath="$(DalamudHome)/FFXIVClientStructs.dll" />
    <Reference Include="Lumina" HintPath="$(DalamudHome)/Lumina.dll" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudHome)/Lumina.Excel.dll" />
    <Reference Include="InteropGenerator.Runtime" HintPath="$(DalamudHome)/InteropGenerator.Runtime.dll" />
    <Reference Include="HexaGen.Runtime" HintPath="$(DalamudHome)/HexaGen.Runtime.dll" />
    <None Include="$(DalamudHome)/cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
